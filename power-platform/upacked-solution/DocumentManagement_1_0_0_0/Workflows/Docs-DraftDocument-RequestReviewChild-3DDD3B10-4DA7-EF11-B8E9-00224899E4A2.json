{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mintek_sharedsharepointonline_acff9"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mintek_sharedoffice365_a47d4"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_approvals_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedapprovals_88329"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "DocumentManagementSiteUrl (mintek_DocumentManagementSiteUrl)": {
          "defaultValue": "https://mintekcoza.sharepoint.com/sites/divisionsdev/Docs",
          "type": "String",
          "metadata": {
            "schemaName": "mintek_DocumentManagementSiteUrl",
            "description": "Site url for document management"
          }
        },
        "Document Management - Draft Documents Url (mintek_DocumentManagementDraftDocumentsUrl)": {
          "defaultValue": "051877cf-dd1b-44cb-961e-7a3da681c5cd",
          "type": "String",
          "metadata": {
            "schemaName": "mintek_DocumentManagementDraftDocumentsUrl",
            "description": "Link to Draft documents Library"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "2b644ff4-d04e-48d8-9c63-51fb79f46c3b"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "title": "DocID",
                  "type": "number",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter a number",
                  "x-ms-content-hint": "NUMBER"
                },
                "email": {
                  "title": "ReviewerEmail",
                  "type": "string",
                  "format": "email",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter an e-mail address",
                  "x-ms-content-hint": "EMAIL"
                }
              },
              "required": [
                "number",
                "email"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_file_properties_-_Document": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "8d91988e-8c78-49a9-99d9-9eedc5b5fe01"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline_1",
              "operationId": "GetFileItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('DocumentManagementSiteUrl (mintek_DocumentManagementSiteUrl)')",
              "table": "@parameters('Document Management - Draft Documents Url (mintek_DocumentManagementDraftDocumentsUrl)')",
              "id": "@triggerBody()['number']"
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
        "Initialize_variable_-_ReviewersComments": {
          "runAfter": {
            "Get_file_properties_-_Document": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "be44e00c-cd0e-4884-9fd1-38e85d6b9de0"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ReviewersComments",
                "type": "string"
              }
            ]
          }
        },
        "Initialize_variable_-_ReviewersComments_on_Document": {
          "runAfter": {
            "Initialize_variable_-_ReviewersComments": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "be44e00c-cd0e-4884-9fd1-38e85d6b9de0"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ReviewersComments on Document",
                "type": "string"
              }
            ]
          }
        },
        "Update_file_properties_-_Draft_Document": {
          "runAfter": {
            "Send_an_email_(V2)_-_Document_Owners_-_End": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f01c282b-88a5-4a18-bcfe-4d8ec1ac8bc3"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline_1",
              "operationId": "PatchFileItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('DocumentManagementSiteUrl (mintek_DocumentManagementSiteUrl)')",
              "table": "@parameters('Document Management - Draft Documents Url (mintek_DocumentManagementDraftDocumentsUrl)')",
              "id": "@outputs('Get_file_properties_-_Document')?['body/ID']",
              "item/Review_x0020_Period": "@outputs('Get_file_properties_-_Document')?['body/Review_x0020_Period']",
              "item/Approver_x0020_Comments": "Reviewers Responses: @{variables('ReviewersComments on Document')}",
              "item/SystemNotes": "Reviewed at @{formatDateTime(addHours(utcNow(), 2), 'yyyy-MM-dd HH:mm')}.\nPower Automate Workflow: "
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
        "Send_an_email_(V2)_-_Document_Owners_-_End": {
          "runAfter": {
            "Apply_to_each_-_Responses": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c600ee97-f720-431e-b9f4-2590ed089188"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365_1",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@outputs('Get_file_properties_-_Document')?['body/Document_x0020_Owner/Email']",
              "emailMessage/Subject": "Review Document: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Number']}",
              "emailMessage/Body": "<style>\n.workflow-footer {\n    font-size: 12px;\n}\n</style>\n<p>Dear Document Owners,</p>\n<p>This is a notification to inform you that a document Review has been done.</p>\n<p>\nDocument No.: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Number']}</br>\nDocument Title: @{outputs('Get_file_properties_-_Document')?['body/Project_x0020_Title']}</br>\nDocument Owner: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Owner/DisplayName']}</br>\n</p>\n@{variables('ReviewersComments')}\n</p>\n<br>\n<p class=\"workflow-footer\">\n    Power Automate Workflow: Docs - Draft Document - Request Approval for this selected file - Child\n</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
        "Apply_to_each_-_Responses": {
          "foreach": "@outputs('Start_and_wait_for_an_approval_-_Reviewers')?['body/responses']",
          "actions": {
            "Append_to_string_variable_-_ReviewersComments": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "28d71397-e446-4ea7-8e34-a5e38974a8d8"
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "ReviewersComments",
                "value": "<p>Reviewer Name: @{items('Apply_to_each_-_Responses')?['responder/displayName']}</br>\nDate: @{formatDateTime(addHours(items('Apply_to_each_-_Responses')?['requestDate'], 2), 'yyyy-MM-dd HH:mm')}</br>\nComment: @{if(empty(items('Apply_to_each_-_Responses')?['comments']),'No Comments',items('Apply_to_each_-_Responses')?['comments'])}</br>\n</p>"
              }
            },
            "Append_to_string_variable_-_ReviewersComments_on_Document": {
              "runAfter": {
                "Append_to_string_variable_-_ReviewersComments": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "28d71397-e446-4ea7-8e34-a5e38974a8d8"
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "ReviewersComments on Document",
                "value": "Reviewer Name: @{items('Apply_to_each_-_Responses')?['responder/displayName']}, \nDate: @{formatDateTime(addHours(items('Apply_to_each_-_Responses')?['requestDate'], 2), 'yyyy-MM-dd HH:mm')}, \nComment: @{if(empty(items('Apply_to_each_-_Responses')?['comments']),'No Comments',items('Apply_to_each_-_Responses')?['comments'])}.\n"
              }
            }
          },
          "runAfter": {
            "Compose_-_Response_Summary": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bcb4e6ec-34c7-49e3-8e8c-d440e76643a4"
          },
          "type": "Foreach"
        },
        "Compose_-_Response_Summary": {
          "runAfter": {
            "Start_and_wait_for_an_approval_-_Reviewers": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a7ba6829-2c97-4b41-bedd-be995519c609"
          },
          "type": "Compose",
          "inputs": "@outputs('Start_and_wait_for_an_approval_-_Reviewers')?['body/responseSummary']"
        },
        "Start_and_wait_for_an_approval_-_Reviewers": {
          "runAfter": {
            "Compose_-_Email_To:_ReviewerEmail": [
              "Succeeded"
            ]
          },
          "limit": {
            "timeout": "P7D"
          },
          "metadata": {
            "operationMetadataId": "70fd0673-418d-4104-9ebf-d7854fb99b67"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_approvals_1",
              "operationId": "StartAndWaitForAnApproval",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
            },
            "parameters": {
              "approvalType": "CustomResponse",
              "WebhookApprovalCreationInput/responseOptions": [
                "Comment"
              ],
              "WebhookApprovalCreationInput/title": "Review @{outputs('Get_file_properties_-_Document')?['body/{ContentType}/Name']} Document: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Number']}",
              "WebhookApprovalCreationInput/assignedTo": "@{triggerBody()['email']};",
              "WebhookApprovalCreationInput/details": "Dear Document Reviewers,\n\nThis is a notification to inform you that a document requires a Review.\n\nPlease review the document to ensure that any necessary updates or actions are completed. The review will be open for 7 days ending at (@{formatDateTime(addHours(addDays(utcNow(), 7), 2), 'yyyy-MM-dd HH:mm')}).\n\nDocument No.: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Number']}\nDocument Title: @{outputs('Get_file_properties_-_Document')?['body/Project_x0020_Title']}\nDocument Owner: @{outputs('Get_file_properties_-_Document')?['body/Document_x0020_Owner/DisplayName']}\n",
              "WebhookApprovalCreationInput/itemLink": "@outputs('Get_file_properties_-_Document')?['body/{Link}']",
              "WebhookApprovalCreationInput/itemLinkDescription": "Link to the Document",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            },
            "retryPolicy": {
              "type": "none"
            }
          }
        },
        "Compose_-_Email_To:_ReviewerEmail": {
          "runAfter": {
            "Initialize_variable_-_ReviewersComments_on_Document": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "78bd3fc6-fbb6-49fe-81b7-99cbce1f078a"
          },
          "type": "Compose",
          "inputs": "@triggerBody()['email']"
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Update_file_properties_-_Draft_Document": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4e393210-99a4-437e-94f6-6e318c19973a"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "response": "@variables('ReviewersComments')"
            },
            "schema": {
              "type": "object",
              "properties": {
                "response": {
                  "title": "Response",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}